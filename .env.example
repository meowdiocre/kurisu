# Application Key
KEY=your-secret-key-here

# Owner bootstrap for a fresh database seed (comma-separated phone numbers)
OWNER_NUMBERS=

# WhatsApp Session Configuration
SESSION_ID=main

# Cache Configuration (lru atau redis)
CACHE_DRIVER=lru
REDIS_URL=

# Database Configuration (sqlite atau mysql)
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=kurisu

# Zapo Store Configuration
STORE_ENABLED=false
STORE_CHATS=true
STORE_CONTACTS=true
STORE_GROUPS=true
STORE_MESSAGES=true
STORE_MESSAGE_RETENTION_DAYS=7
STORE_BATCH_INTERVAL_MS=600000

# AI Provider Configuration (OpenAI Compatible)
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
TAVILY_API_KEY=

# Text-to-Speech voice replies (requires edge-tts + ffmpeg on the host)
# TTS_REPLY_MODE: off | auto | voice | both
# auto = voice note hanya saat user meminta suara
TTS_REPLY_MODE=auto
TTS_PROVIDER=edge
TTS_VOICE=id-ID-GadisNeural
TTS_GOOGLE_LANG=id
TTS_MAX_CHARS=400
